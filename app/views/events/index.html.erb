<% content_for :title, "イベント一覧" %>

<h1>開催予定のイベント</h1>

<% if @events.any? %>
  <table class="events">
    <thead>
      <tr>
        <th>開催日時</th>
        <th>イベント</th>
        <th>参加者</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= l event.starts_at, format: :short %></td>
          <td><%= link_to event.title, event %></td>
          <td><%= event.participants.count %> / <%= event.capacity %> 人</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>開催予定のイベントはまだありません。</p>
<% end %>
